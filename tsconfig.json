{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    // The build scripts are plain ESM JavaScript on purpose (node runs them
    // directly, before and after tsup). allowJs lets the packaging tests import
    // the same constants the build uses instead of duplicating them, and TS
    // infers their types from the source.
    "allowJs": true,
    "paths": {
      "forma/*": ["./src/*"]
    }
  },
  // tsup.config.ts and scripts/ are included so `npm run typecheck` covers the
  // build definition itself, not just the library. rootDir is "." for the same
  // reason; tsc is only ever run with --noEmit here (tsup produces dist).
  "include": ["src/**/*", "tsup.config.ts", "scripts/**/*.mjs"]
}
